rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /players/{uid} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    match /weekly/{week}/scores/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['qid','userId','userName']);
      allow read, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
